# ============================================================================
# Aetheris Configuration (.env)
# ============================================================================

# Google Gemini API Key (from https://aistudio.google.com/apikey)
# Optional for `--demo` CLI runs, tests, and the demo web dashboard.
GEMINI_API_KEY=

# Model selection (defaults to Gemini 3.8 Flash + Gemini Embedding 2)
AETHERIS_LLM_MODEL=gemini-3.8-flash
AETHERIS_THINKING_LEVEL=low
AETHERIS_EMBEDDING_MODEL=gemini-embedding-2
AETHERIS_EMBEDDING_DIM=768

# Scientific Literature Sources (Optional polite pool / higher rate limits)
AETHERIS_OPENALEX_EMAIL=
AETHERIS_OPENALEX_API_KEY=
AETHERIS_SEMANTIC_SCHOLAR_API_KEY=
AETHERIS_ENABLE_SEMANTIC_SCHOLAR=true

# Retrieval & Verification Controls
# Options: graph_hybrid | hybrid | bm25 | dense
AETHERIS_RETRIEVAL_MODE=graph_hybrid
AETHERIS_ENABLE_GROUNDING_GUARD=true
AETHERIS_MAX_SKEPTIC_ROUNDS=1
AETHERIS_SKEPTIC_MIN_CONFIDENCE=0.72

# Resource & Budget Guardrails
AETHERIS_MAX_LLM_CALLS=200
AETHERIS_MAX_TOTAL_TOKENS=2000000
AETHERIS_MAX_SECONDS=900
